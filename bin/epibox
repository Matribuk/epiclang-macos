#!/usr/bin/env bash
# Ouvre un shell Linux, ou lance une commande, dans la meme image :
# indispensable pour executer les binaires produits par epiclang.
set -uo pipefail

IMAGE="${EPICLANG_IMAGE:-epiclang:local}"

# -t seulement si l'entree est un terminal, sinon les pipes sont casses.
tty_flag=""
[ -t 0 ] && tty_flag="-t"

docker run --rm -i $tty_flag \
    --platform linux/amd64 \
    -u "$(id -u):$(id -g)" \
    -v "$PWD":"$PWD" -w "$PWD" \
    --entrypoint "" \
    "$IMAGE" "${@:-bash}"
status=$?

if [ "$status" -eq 125 ] && ! docker info >/dev/null 2>&1; then
    echo "epibox: Docker n'est pas demarre. Ouvre Docker Desktop, puis reessaie." >&2
fi
exit "$status"
